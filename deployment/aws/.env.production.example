# Production Environment Variables for Lumina AI Learning
# Copy this file to deployment/aws/.env.production locally, then store the real
# contents in the GitHub secret AWS_PROD_ENV_FILE for automated AWS deploys.

GEMINI_API_KEY=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal container URLs
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional public/runtime URLs
NEXT_PUBLIC_API_URL=
API_URL=http://backend:8000
ML_SERVICE_URL=http://ml-service:9000
