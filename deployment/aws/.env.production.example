# ============================================================
# Lumina AI Learning — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to git.
#
# Usage:
#   cp deployment/aws/.env.production.example deployment/aws/.env.production
#   nano deployment/aws/.env.production
# ============================================================

# ─── Application ────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Public URL of your EC2 instance (no trailing slash).
# Use your domain name once DNS is set up, e.g. https://lumina.yourdomain.com
# For IP-only access use: http://13.232.166.186
NEXT_PUBLIC_API_URL=http://13.232.166.186

# ─── PostgreSQL (self-hosted on EC2) ────────────────────────
POSTGRES_USER=lumina
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=lumina_db
DATABASE_URL=postgresql://lumina:CHANGE_ME_strong_password_here@postgres:5432/lumina_db

# ─── Supabase (if using managed Supabase instead of local PG) ─
# DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_JWT_SECRET=your_jwt_secret

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Neo4j ──────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ─── MinIO (S3-compatible object storage) ───────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
AWS_BUCKET_NAME=lumina-uploads

# ─── AWS S3 (if using S3 instead of MinIO) ──────────────────
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-south-1

# ─── AI / LLM Keys ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── ChromaDB ───────────────────────────────────────────────
CHROMA_DB_PATH=/app/db/chroma

# ─── ML Service ─────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:9000

# ─── Authentication / JWT ───────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Sentry (optional error tracking) ───────────────────────
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ─── Email (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAILS_FROM_EMAIL=noreply@yourdomain.com
