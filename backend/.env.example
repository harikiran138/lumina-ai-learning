# ================================================================
# Lumina Backend — Environment Variables Template
# Copy to .env and fill in real values.
# Run infra/aws/provision.sh to auto-generate AWS values.
# ================================================================

# === CORE ===
ENVIRONMENT=production
PORT=8000
DEBUG=false
REDACT_PII_LOGS=true
FRONTEND_URL=http://localhost:3000

# SECRET KEYS — generate with: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# === DATABASE (AWS RDS PostgreSQL) ===
# Format: postgresql+asyncpg://user:password@rds-endpoint:5432/dbname
DATABASE_URL=postgresql+asyncpg://lumina_user:<PASSWORD>@<RDS_ENDPOINT>:5432/lumina_db

# === CACHE (AWS ElastiCache Redis) ===
REDIS_URL=redis://<ELASTICACHE_ENDPOINT>:6379/0
CELERY_BROKER_URL=redis://<ELASTICACHE_ENDPOINT>:6379/1
CELERY_RESULT_BACKEND=redis://<ELASTICACHE_ENDPOINT>:6379/2

# === OBJECT STORAGE (AWS S3) ===
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=lumina-media

# === SUPABASE (Auth + Row-Level Security) ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === GRAPH DB (Neo4j AuraDB Free) ===
NEO4J_URI=bolt+s://<AURA_ENDPOINT>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === AI / LLM ===
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_SIMPLE_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_COMPLEX_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# HF_TOKEN — only needed for first TrOCR model download
HF_TOKEN=

# === ML SERVICE ===
# FAISS_KEEP_IN_MEMORY: true on t3.large, false on t3.medium
FAISS_KEEP_IN_MEMORY=true
# TROCR_LOAD_ON_DEMAND: always true — model unloads after each grading task
TROCR_LOAD_ON_DEMAND=true

# === OBSERVABILITY (optional) ===
SENTRY_DSN=
