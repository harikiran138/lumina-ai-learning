# --- Stage 1: Build Dependencies ---
FROM python:3.11-slim as builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Install any necessary build-essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.slim.txt .
RUN pip install --no-cache-dir -r requirements.slim.txt

# --- Stage 2: Final Image ---
FROM python:3.11-slim

WORKDIR /app

# Final environment
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Need libpq for Postgres and GL/dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source
COPY . .

# Environment Defaults
ENV PORT=8000
EXPOSE 8000

# Entrypoint will be overridden by docker-compose for worker/api
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
