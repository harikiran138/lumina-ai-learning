{
    "framework": "nextjs",
    "installCommand": "npm install && cd frontend/web && npm install",
    "buildCommand": "cd frontend/web && npm run build",
    "outputDirectory": "frontend/web/.next",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://lumina-backend.onrender.com/api/:path*"
        }
    ]
}
