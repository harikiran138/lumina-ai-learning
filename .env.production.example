# Lumina AI Learning Platform - Production Environment Configuration

# ═════════════════════════════════════════════════════════════════════════════
# API Configuration
# ═════════════════════════════════════════════════════════════════════════════

API_V1_STR=/api
ENVIRONMENT=production
SECRET_KEY=your-super-secret-key-minimum-32-characters
JWT_SECRET=your-jwt-secret-key-minimum-32-characters

# ═════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═════════════════════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_DB=lumina
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-change-this
DATABASE_URL=postgresql://postgres:your-postgres-password-change-this@postgres:5432/lumina

# Redis Cache & Queue
REDIS_PASSWORD=your-redis-password-change-this
REDIS_URL=redis://:your-redis-password-change-this@redis:6379/0

# Neo4j Graph Database
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-change-this
NEO4J_URI=bolt://neo4j:7687

# ═════════════════════════════════════════════════════════════════════════════
# Supabase (Optional - for using Supabase instead of local DB)
# ═════════════════════════════════════════════════════════════════════════════

SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ═════════════════════════════════════════════════════════════════════════════
# AI Services Configuration
# ═════════════════════════════════════════════════════════════════════════════

# OpenRouter (Primary)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_SIMPLE_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_COMPLEX_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://lumina-ai.learning
OPENROUTER_APP_NAME=Lumina AI Learning

# Google Gemini (Optional Fallback)
GEMINI_API_KEY=

# Anthropic Claude (Optional Fallback)
ANTHROPIC_API_KEY=

# OpenAI GPT (Optional Fallback)
OPENAI_API_KEY=

# Hugging Face (Optional)
HF_TOKEN=

# ═════════════════════════════════════════════════════════════════════════════
# Storage Configuration
# ═════════════════════════════════════════════════════════════════════════════

# MinIO (Local Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-minio-password-change-this
MINIO_URL=http://minio:9000

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=

# ═════════════════════════════════════════════════════════════════════════════
# Email Configuration
# ═════════════════════════════════════════════════════════════════════════════

# SendGrid
SENDGRID_API_KEY=

# Gmail (App Password)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_PASSWORD=your-gmail-app-password

# ═════════════════════════════════════════════════════════════════════════════
# Frontend Configuration
# ═════════════════════════════════════════════════════════════════════════════

FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ENVIRONMENT=production
NODE_ENV=production

# CORS Origins (comma-separated)
CORS_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# ═════════════════════════════════════════════════════════════════════════════
# Security Configuration
# ═════════════════════════════════════════════════════════════════════════════

SECURE_COOKIES=true
# List of trusted hosts (comma-separated)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ═════════════════════════════════════════════════════════════════════════════
# Monitoring & Logging
# ═════════════════════════════════════════════════════════════════════════════

# Sentry Error Tracking (Optional)
SENTRY_DSN=

# Logging Configuration
LOG_LEVEL=INFO
REDACT_PII_LOGS=true

# ═════════════════════════════════════════════════════════════════════════════
# Feature Flags
# ═════════════════════════════════════════════════════════════════════════════

# Force using local database (for testing)
LUMINA_FORCE_LOCAL_DB=0

# Force using real database
LUMINA_FORCE_REAL_DB=1

# ═════════════════════════════════════════════════════════════════════════════
# ML Service Configuration (Optional)
# ═════════════════════════════════════════════════════════════════════════════

ML_SERVICE_URL=http://ml-service:5000
OLLAMA_HOST=http://ollama:11434

# ═════════════════════════════════════════════════════════════════════════════
# Rate Limiting
# ═════════════════════════════════════════════════════════════════════════════

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ═════════════════════════════════════════════════════════════════════════════
# Advanced Configuration
# ═════════════════════════════════════════════════════════════════════════════

# Database pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Workers (set to number of CPU cores)
WORKER_COUNT=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# File upload limits (in MB)
MAX_UPLOAD_SIZE=100

# Cache TTL (in seconds)
CACHE_TTL=3600
