{
  "v": 2,
  "name": "Lumina API Tests",
  "requests": [
    {
      "name": "Health Check",
      "method": "GET",
      "endpoint": "http://localhost:8000/health",
      "testScript": "pw.test(\"Status code is 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n});\n\npw.test(\"Database status is returned\", () => {\n  const body = pw.response.body;\n  pw.expect(body).toHaveProperty(\"database\");\n  pw.expect(body).toHaveProperty(\"status\", \"ok\");\n});"
    },
    {
      "name": "Root Endpoint",
      "method": "GET",
      "endpoint": "http://localhost:8000/",
      "testScript": "pw.test(\"Status code is 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n});\n\npw.test(\"Welcome message is correct\", () => {\n  const body = pw.response.body;\n  pw.expect(body).toHaveProperty(\"message\", \"Welcome to Lumina API\");\n});"
    },
    {
      "name": "List Courses",
      "method": "GET",
      "endpoint": "http://localhost:8000/api/courses/list",
      "testScript": "pw.test(\"Status code is 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n});\n\npw.test(\"Returns an array of courses\", () => {\n  pw.expect(Array.isArray(pw.response.body)).toBe(true);\n});"
    },
    {
      "name": "Login Token",
      "method": "POST",
      "endpoint": "http://localhost:8000/api/auth/token",
      "body": {
        "contentType": "application/x-www-form-urlencoded",
        "body": "username=test@example.com&password=password123"
      }
    },
    {
      "name": "Get Personalization Profile",
      "method": "GET",
      "endpoint": "http://localhost:8000/api/personalization/profile"
    },
    {
      "name": "Get Tutor Projection (Self)",
      "method": "GET",
      "endpoint": "http://localhost:8000/api/personalization/projection/tutor"
    },
    {
      "name": "Get Pathway Projection (Self)",
      "method": "GET",
      "endpoint": "http://localhost:8000/api/personalization/projection/pathway"
    },
    {
      "name": "Run Profile Refresh",
      "method": "POST",
      "endpoint": "http://localhost:8000/api/automation/run/profile-refresh",
      "body": {
        "contentType": "application/json",
        "body": "{\\n  \\\"limit\\\": 100\\n}"
      }
    },
    {
      "name": "List Knowledge Graph Nodes",
      "method": "GET",
      "endpoint": "http://localhost:8000/api/knowledge-graph/demo-course"
    },
    {
      "name": "Upsert Knowledge Graph Nodes",
      "method": "POST",
      "endpoint": "http://localhost:8000/api/knowledge-graph/demo-course/nodes",
      "body": {
        "contentType": "application/json",
        "body": "{\\n  \\\"nodes\\\": [\\n    {\\n      \\\"concept\\\": \\\"arrays\\\",\\n      \\\"difficulty\\\": \\\"beginner\\\",\\n      \\\"prerequisites\\\": []\\n    },\\n    {\\n      \\\"concept\\\": \\\"recursion\\\",\\n      \\\"difficulty\\\": \\\"intermediate\\\",\\n      \\\"prerequisites\\\": [\\\"arrays\\\"]\\n    }\\n  ]\\n}"
      }
    }
  ]
}
