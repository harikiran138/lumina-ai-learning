# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=HandwrittenAssignment
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./handwritten_lms.db

# ── HuggingFace ───────────────────────────────────────────────────────────────
HUGGINGFACE_API_TOKEN=hf_your_token_here

# TrOCR model - best balance of speed vs accuracy
# Options:
#   microsoft/trocr-base-handwritten    (faster, less accurate)
#   microsoft/trocr-large-handwritten   (slower, more accurate) ← recommended
TROCR_MODEL=microsoft/trocr-large-handwritten

# LLM for evaluation - HuggingFace Inference API (free tier available)
# Options:
#   mistralai/Mistral-7B-Instruct-v0.3  (great for grading, free)
#   meta-llama/Meta-Llama-3-8B-Instruct (excellent, needs approval)
#   HuggingFaceH4/zephyr-7b-beta        (reliable, always available)
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── OpenAI fallback (optional, comment out if not using) ─────────────────────
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ── Redis (for async job queue) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── OCR Confidence ────────────────────────────────────────────────────────────
OCR_CONFIDENCE_THRESHOLD=0.70   # below this → flag for teacher
IMAGE_MIN_DPI=150                # below this → reject upload
